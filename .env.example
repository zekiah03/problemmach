# Postgres
DATABASE_URL="postgresql://user:password@localhost:5432/problemmach?schema=public"

# Anthropic (運営キー: BYOK未設定ユーザー向け)
ANTHROPIC_API_KEY="sk-ant-..."

# LLM モデル
LLM_MODEL_FAST="claude-haiku-4-5-20251001"
LLM_MODEL_DEEP="claude-sonnet-4-6"

# APIキー暗号化用
ENCRYPTION_KEY="32バイトのbase64文字列。opensslで生成: openssl rand -base64 32"

# アプリ設定
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"
