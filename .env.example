# Postgres
DATABASE_URL="postgresql://user:password@localhost:5432/problemmach?schema=public"

# Anthropic (運営キー: BYOK未設定ユーザー向け)
ANTHROPIC_API_KEY="sk-ant-..."

# LLM モデル
LLM_MODEL_FAST="claude-haiku-4-5-20251001"
LLM_MODEL_DEEP="claude-sonnet-4-6"

# APIキー暗号化用
ENCRYPTION_KEY="32バイトのbase64文字列。opensslで生成: openssl rand -base64 32"

# アプリ設定
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# Auth.js (Phase 1)
AUTH_SECRET="openssl rand -base64 32 で生成"
AUTH_URL="http://localhost:3000"

# Resend (Phase 1: メール送信)
RESEND_API_KEY="re_..."
EMAIL_FROM="problemmach <noreply@your-domain>"

# Cron バッチ用シークレット (Phase 1)
CRON_SECRET="長めのランダム文字列。X-Cron-Secret ヘッダで照合"

# OpenAI (Phase 1: embedding 用、運営側の任意キー)
OPENAI_API_KEY="sk-..."
