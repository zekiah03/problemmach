// Phase 0 + Phase 1 schema
generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector]
}

// ユーザー (ゲスト + 認証ユーザー)
// Auth.js v5 互換 (emailVerified, image, accounts, sessions)
model User {
  id                  String   @id @default(cuid())
  email               String?  @unique
  emailVerified       DateTime?
  image               String?
  isGuest             Boolean  @default(true)
  guestToken          String?  @unique
  ageConfirmed        Boolean  @default(false)
  termsAcceptedAt     DateTime?
  persona             Persona  @default(FLAT_POLITE)
  displayName         String?
  encryptedApiKey     String?
  region              String   @default("ja")
  createdAt           DateTime @default(now())
  lastActiveAt        DateTime @default(now())

  posts               Post[]
  accounts            Account[]
  sessions            Session[]
  insights            PotentialInsight[]
  matchCondition      UserMatchCondition?

  @@index([guestToken])
  @@index([email])
}

// Auth.js 標準テーブル
model Account {
  id                String  @id @default(cuid())
  userId            String
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expires      DateTime
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

enum Persona {
  FLAT_POLITE
  FLAT_CASUAL
  EXPERT
  FRIEND
}

// 悩み投稿 (1セッション = 1 Post)
model Post {
  id              String     @id @default(cuid())
  userId          String
  user            User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  initialText     String     @db.Text
  status          PostStatus @default(IN_CONVERSATION)
  riskFlag        RiskFlag   @default(NONE)
  matchEligible   Boolean    @default(true)

  // 最終的に確定した分類 (Analysisと同期)
  categoryPrimary   Category?
  categorySecondary Category?
  coexistSubtype    CoexistSub?
  longTermFlag      Boolean  @default(false)

  createdAt       DateTime   @default(now())
  completedAt     DateTime?
  expiresAt       DateTime?

  turns           ConversationTurn[]
  analysis        Analysis?
  presented       PresentedTemplate[]
  emotions        EmotionScore[]
  matchesAsA      Match[] @relation("MatchPostA")
  matchesAsB      Match[] @relation("MatchPostB")

  @@index([userId])
  @@index([status])
  @@index([expiresAt])
  @@index([matchEligible, status])
}

enum PostStatus {
  IN_CONVERSATION
  ANALYZED
  CLOSED
  BLOCKED
}

enum RiskFlag {
  NONE
  SELF_HARM
  HARM_OTHERS
  ILLEGAL
  MEDICAL
  PII_DETECTED
}

enum Category {
  DECISION
  CONTROL
  IDENTITY
  RISK
}

enum CoexistSub {
  LOSS
  CONSTRAINT
  INEVITABLE
  OTHER_PERSON
}

// 対話の1ターン
model ConversationTurn {
  id              String   @id @default(cuid())
  postId          String
  post            Post     @relation(fields: [postId], references: [id], onDelete: Cascade)

  turnNumber      Int
  role            TurnRole
  content         String   @db.Text
  questionOptions Json?
  selectedOption  String?
  filledSlot      TimeSlot?

  createdAt       DateTime @default(now())

  @@unique([postId, turnNumber])
  @@index([postId])
}

enum TurnRole {
  USER
  AI
}

enum TimeSlot {
  ORIGIN       // A: 起点
  COURSE       // B: 経過
  PRESENT      // C: 現在
  IDEAL        // D: 理想
  CONSTRAINT   // E: 制約
}

// 顕在分析結果
model Analysis {
  id                   String   @id @default(cuid())
  postId               String   @unique
  post                 Post     @relation(fields: [postId], references: [id], onDelete: Cascade)

  structure            Json     // { ideal, reality, uncertainty }
  categoryPrimary      Category
  categorySecondary    Category?
  confidence           Int
  timeInfo             Json     // { onset, duration, deadline }
  solutionTypeScores   Json     // { info, action, dialog, coexist, acceptance }
  selfResolvableScore  Int
  coexistSubtype       CoexistSub?
  longTermFlag         Boolean  @default(false)
  matchRecommend       Boolean  @default(false)
  matchReason          String?

  promptVersion        String
  llmUsed              String
  createdAt            DateTime @default(now())
}

// 解決の型マスター
model SolutionTemplate {
  id                 String     @id
  type               SolutionType
  sub                CoexistSub?
  title              String
  question           String     @db.Text
  whyItFits          String     @db.Text
  appliesToCategory  Category[]
  isActive           Boolean    @default(true)
  version            Int        @default(1)
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  presented          PresentedTemplate[]

  @@index([type])
  @@index([isActive])
}

enum SolutionType {
  INFO
  ACTION
  DIALOG
  COEXIST
  ACCEPTANCE
}

// 提示されたテンプレの記録
model PresentedTemplate {
  id          String           @id @default(cuid())
  postId      String
  post        Post             @relation(fields: [postId], references: [id], onDelete: Cascade)
  templateId  String
  template    SolutionTemplate @relation(fields: [templateId], references: [id])
  order       Int
  userClicked Boolean          @default(false)
  createdAt   DateTime         @default(now())

  @@unique([postId, templateId])
  @@index([postId])
}

// 投稿後の感情スコア (テキスト)
model EmotionScore {
  id           String         @id @default(cuid())
  postId       String
  post         Post           @relation(fields: [postId], references: [id], onDelete: Cascade)
  text         String         @db.Text
  scoreNumeric Int?
  context      EmotionContext
  recordedAt   DateTime       @default(now())

  @@index([postId])
}

enum EmotionContext {
  POST_ANALYSIS
  FOLLOW_UP_1W
  FOLLOW_UP_1M
}

// Phase 1: 潜在分析 (バッチで生成、ユーザーには直接見せない)
model LatentAnalysis {
  id                   String   @id @default(cuid())
  postId               String   @unique
  emotionLayers        Json     // { surface, deep, meta }
  cognitiveDistortions Json     // 検出された歪みの配列
  rootCauses           Json     // 5Why 風の連鎖
  patternTags          String[] // 過去投稿との関連タグ
  visibility           InsightVisibility @default(HIDDEN)
  llmUsed              String
  promptVersion        String
  createdAt            DateTime @default(now())

  @@index([postId])
}

enum InsightVisibility {
  HIDDEN
  HINT       // 気づきフェーズで本人にヒントとして提示可能
  SHOWN
}

// Phase 1: 気づきフェーズで本人に還元する候補
model PotentialInsight {
  id          String              @id @default(cuid())
  userId      String
  user        User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  insightType String
  detail      Json
  confidence  Int
  status      InsightStatus       @default(PENDING)
  createdAt   DateTime            @default(now())
  shownAt     DateTime?

  @@index([userId])
  @@index([status])
}

enum InsightStatus {
  PENDING
  SHOWN
  DISMISSED
  ACCEPTED
}

// Phase 1: 投稿の埋め込みベクトル (pgvector)
// Phase 2 のマッチングで本格使用
model PostEmbedding {
  postId        String  @id
  ideal         Unsupported("vector(1536)")?
  reality       Unsupported("vector(1536)")?
  needVector    Unsupported("vector(1536)")?
  offerVector   Unsupported("vector(1536)")?
  fullText      Unsupported("vector(1536)")?
  modelUsed     String
  createdAt     DateTime @default(now())
}

// Phase 2: マッチング条件 (現実性フィルタ用)
model UserMatchCondition {
  userId            String   @id
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // 都道府県 (例: "東京都", "北海道", null=未指定)
  locationRegion    String?
  // 利用可能な時間帯 (例: ["MORNING", "EVENING", "NIGHT"])
  availableSlots    String[]
  language          String   @default("ja")
  costTolerance     CostTolerance @default(FREE)
  skillTags         String[]
  acceptMatch       Boolean  @default(true)
  updatedAt         DateTime @updatedAt
}

enum CostTolerance {
  FREE
  LOW       // ~ 1000 円
  MEDIUM    // ~ 5000 円
  HIGH      // 5000円以上もOK
}

// Phase 2: マッチ
model Match {
  id                 String      @id @default(cuid())
  postAId            String
  postA              Post        @relation("MatchPostA", fields: [postAId], references: [id], onDelete: Cascade)
  postBId            String
  postB              Post        @relation("MatchPostB", fields: [postBId], references: [id], onDelete: Cascade)
  matchType          MatchType
  compatibilityScore Int         // 0-100
  realnessScore      Int         // 0-100
  status             MatchStatus @default(SUGGESTED)
  acceptedByA        Boolean     @default(false)
  acceptedByB        Boolean     @default(false)
  createdAt          DateTime    @default(now())
  expiresAt          DateTime
  // チャットルーム (Phase 3)
  chatRoom           ChatRoom?

  @@unique([postAId, postBId])
  @@index([postAId])
  @@index([postBId])
  @@index([status])
}

enum MatchType {
  MIRROR        // 同類型ミラー
  EXPERIENCED   // 経験者マッチ (片方が経験済み)
}

enum MatchStatus {
  SUGGESTED
  ACCEPTED_A
  ACCEPTED_B
  MUTUAL
  DECLINED
  EXPIRED
}

// Phase 3 で実装予定 (schema は先に置く)
model ChatRoom {
  id        String     @id @default(cuid())
  matchId   String     @unique
  match     Match      @relation(fields: [matchId], references: [id], onDelete: Cascade)
  status    ChatStatus @default(ACTIVE)
  createdAt DateTime   @default(now())
  closedAt  DateTime?
}

enum ChatStatus {
  ACTIVE
  CLOSED
  REPORTED
}
